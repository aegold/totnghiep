# AI Tutor microservice configuration.
#
# Leave GEMINI_API_KEY / OPENAI_API_KEY blank to run fully offline: the service
# falls back to the Local Heuristic Streamer automatically. That is the
# recommended state for a thesis defense.

PORT=8000

# AI_PROVIDER: auto (try every configured key) | gemini | openai | local
AI_PROVIDER=auto

GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.0-flash

OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

# Course materials ingested by the RAG pipeline.
MATERIALS_DIR=../be-learning/uploads/materials
CHROMA_PERSIST_DIR=./data/chromadb

CHUNK_SIZE=450
CHUNK_OVERLAP=50
TOP_K=3