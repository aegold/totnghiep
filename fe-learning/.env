# Base URL of the Spring Boot API.
#
# Absolute during local development so the browser talks to the backend
# CROSS-ORIGIN and the CORS configuration is genuinely exercised. Leaving it
# unset falls back to the relative '/api/v1', which Vite proxies to :8080 and
# keeps the browser same-origin - the safer choice behind a shared reverse proxy.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Origin the Vite dev server proxies /api to.
VITE_BACKEND_ORIGIN=http://localhost:8080

# Base URL of the FastAPI AI Tutor microservice (port 8000).
#
# Separate from VITE_API_BASE_URL on purpose: the tutor is its own
# service, so the browser calls it directly and its CORS configuration
# for http://localhost:5173 is genuinely exercised.
VITE_AI_BASE_URL=http://localhost:8000/api/v1
